{
	"format_on_save": "on",
	"lsp": {
		"deno": {
			"settings": {
				"deno": {
					"enable": true,
					"enablePaths": ["./supabase/functions"],
					"lint": true
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"language_servers": [
				"deno",
				"vtsls",
				"biome",
				"!typescript-language-server",
				"!eslint",
				"..."
			],
			"prettier": { "allowed": false },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": { "name": "biome" }
			}
		},

		"TypeScript": {
			"language_servers": [
				"deno",
				"vtsls",
				"biome",
				"!typescript-language-server",
				"!eslint",
				"..."
			],
			"prettier": { "allowed": false },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": { "name": "biome" }
			}
		},
		"TSX": {
			"language_servers": [
				"deno",
				"vtsls",
				"biome",
				"!typescript-language-server",
				"!eslint",
				"..."
			],
			"prettier": { "allowed": false },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": { "name": "biome" }
			}
		},
		"JSON": {
			"language_servers": ["json-language-server", "biome", "..."],
			"prettier": { "allowed": false },
			"formatter": {
				"language_server": { "name": "biome" }
			}
		},
		"JSONC": {
			"language_servers": ["json-language-server", "biome", "..."],
			"prettier": { "allowed": false },
			"formatter": {
				"language_server": { "name": "biome" }
			}
		}
	}
}
