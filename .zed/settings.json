{
  "format_on_save": "on",
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "enablePaths": ["./supabase/functions"],
          "lint": true,
        },
      },
    },
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "deno",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TypeScript": {
      "language_servers": [
        "deno",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TSX": {
      "language_servers": [
        "deno",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JSON": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "biome", "format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "JSONC": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "biome", "format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
  },
}
